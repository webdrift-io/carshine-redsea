# ============================================================================
# Landing Page — Public environment variables
# ----------------------------------------------------------------------------
# Vite exposes ONLY variables prefixed with VITE_ to the browser bundle.
# Do NOT put secrets here. These are public, frontend-safe values only.
# ============================================================================

# Base URL for the public booking API (no trailing slash).
# - Production example: https://api.carshineredsea.com
# - Local dev fallback: http://localhost:5000
# - Override per build with: VITE_API_BASE_URL=... npm run build:en
VITE_API_BASE_URL=http://localhost:5000

# WhatsApp fallback URL shown to the user when the booking API is unreachable
# or returns a controlled failure. Include the phone in E.164 form, no '+'.
# Default: Carshine Redsea public WhatsApp number.
VITE_WHATSAPP_FALLBACK_URL=https://wa.me/201555567205

# Source identifier stored on the booking row (defaults to "WEB_FORM").
# Keep as-is unless you are instrumenting a new landing surface.
VITE_BOOKING_SOURCE=WEB_FORM
