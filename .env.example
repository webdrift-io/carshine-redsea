# =============================================================================
# CarShine Red Sea — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
# Frontend origin for CORS (comma-separated for multiple)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://carshineredsea.com

# -----------------------------------------------------------------------------
# BUSINESS CONTACT / PAYMENT ROUTING
# -----------------------------------------------------------------------------
BUSINESS_PHONE_LOCAL=01555567205
BUSINESS_PHONE_E164=+201555567205
BUSINESS_WHATSAPP_NUMBER=201555567205
INSTAPAY_RECEIVER_MOBILE=01555567205

# -----------------------------------------------------------------------------
# DATABASE (SQLite for local, PostgreSQL for production)
# -----------------------------------------------------------------------------
# SQLite (local development) - file path relative to service-agent/
DATABASE_URL=sqlite:./database.sqlite

# PostgreSQL (production) - uncomment and configure for production
# DATABASE_URL=postgresql://user:password@host:5432/carshine?sslmode=require

# -----------------------------------------------------------------------------
# AI AGENT (PRIMARY: MiniMax | FALLBACK: Gemini | LAST RESORT: rule-based)
# -----------------------------------------------------------------------------
# The AI agent is the brain of the chatbot. It handles:
# - Direct user answers (multilingual: AR/EN/DE)
# - Booking creation (extracts fields from conversation)
# - Calendar management
# - Notifications
# - Website widget responses
#
# MiniMax is the recommended PRIMARY provider (best at structured output + tool use).
# Gemini is the FALLBACK (good multilingual, free tier).
# If neither is set, falls back to rule-based responses (English-only).
#
# MiniMax: https://platform.minimax.io/  (API keys -> create key)
# Gemini:  https://aistudio.google.com/apikey
MiniMax_API_KEY=your_minimax_chat_key_here
MiniMax_MODEL=MiniMax-M3
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# MINIMAX IMAGE GENERATION (marketing photos + website imagery)
# -----------------------------------------------------------------------------
# Used by service-agent/services/image-generation.js. Server-side ONLY — this
# key is never sent to the browser; the frontend calls the authenticated
# /api/admin/marketing/images endpoint instead.
# Generated PNGs are saved under service-agent/generated-media/ and served
# read-only at /media/...
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_IMAGE_MODEL=image-01
# International endpoint by default; some accounts use https://api.minimaxi.com
MINIMAX_API_BASE=https://api.minimax.io

# -----------------------------------------------------------------------------
# WHATSAPP BUSINESS API (Meta Cloud API or Twilio)
# -----------------------------------------------------------------------------
# Meta WhatsApp Cloud API
WHATSAPP_PROVIDER=meta
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=a_secure_random_string_of_your_choice
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id_here
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# Deprecated legacy aliases. Do not use for new setup. Use WHATSAPP_*.
# META_VERIFY_TOKEN=your_webhook_verify_token_here
# META_APP_SECRET=your_meta_app_secret_here
# META_ACCESS_TOKEN=your_meta_access_token_here
# META_PHONE_NUMBER_ID=your_phone_number_id_here
# META_WABA_ID=your_waba_id_here

# Alternative: Twilio WhatsApp
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# -----------------------------------------------------------------------------
# EMAIL (Nodemailer) - for booking confirmations
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM="CarShine Red Sea <noreply@carshineredsea.com>"
EMAIL_ADMIN=admin@carshineredsea.com

# -----------------------------------------------------------------------------
# ADMIN AUTHENTICATION (JWT)
# -----------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_long_random_secret_key_here_min_64_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Admin credentials (for initial login - change immediately!)
ADMIN_EMAIL=admin@carshineredsea.com
ADMIN_PASSWORD_HASH=  # bcrypt hash, generate on first run

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000        # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100        # per window per IP
RATE_LIMIT_WHATSAPP_MAX=30         # per phone per hour

# -----------------------------------------------------------------------------
# TIKTOK MARKETING (Postiz, RevenueCat, OpenAI)
# -----------------------------------------------------------------------------
# Postiz - https://postiz.pro/oliverhenry
POSTIZ_API_KEY=your_postiz_api_key_here
POSTIZ_TIKTOK_INTEGRATION_ID=your_tiktok_integration_id
POSTIZ_INSTAGRAM_INTEGRATION_ID=your_instagram_integration_id
POSTIZ_FACEBOOK_INTEGRATION_ID=your_facebook_integration_id

# RevenueCat (optional - for conversion tracking)
# https://www.revenuecat.com/
RC_API_KEY=your_revenuecat_v2_secret_key_here
RC_PROJECT_ID=your_project_id_here

# OpenAI Image Generation (for TikTok slides)
# Use gpt-image-1.5 (NOT gpt-image-1)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_IMAGE_MODEL=gpt-image-1.5

# Alternative: Stability AI
# STABILITY_API_KEY=your_stability_key

# Alternative: Replicate
# REPLICATE_API_TOKEN=your_replicate_token

# -----------------------------------------------------------------------------
# EXTERNAL SERVICES
# -----------------------------------------------------------------------------
# Google Maps / Places (for location validation)
GOOGLE_MAPS_API_KEY=your_google_maps_key

# Cloudflare Tunnel (for local webhook testing)
# CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
ENABLE_TIKTOK_PIPELINE=false
ENABLE_REVENUECAT=false
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_WHATSAPP_WEBHOOK=false
