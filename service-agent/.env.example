# =============================================================================
# CarShine Red Sea — Service Agent .env.example
# Copy to `.env` and fill in real values.
# =============================================================================

# --- Server ---
PORT=5000
NODE_ENV=development
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:5000
WEBHOOK_BASE_URL=http://localhost:5000
PUBLIC_PORTAL_URL=http://localhost:5000/portal
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173,http://127.0.0.1:5000,http://127.0.0.1:5173

# --- Database ---
# Optional. Defaults to ./database.sqlite. In production, point this at a
# persistent disk path and back it up.
DATABASE_PATH=./database.sqlite

# --- Mastra multi-agent system ---
# When `true` (default), the new orchestrator in `service-agent/agents/orchestrator.js`
# handles incoming messages. When `false`, the legacy monolith in
# `service-agent/minimax-agent.js` is used as a fallback.
USE_MASTRA_AGENT=true

# OpenAI key for the Mastra agents (router/intake/booking/handoff).
# The orchestrator works WITHOUT this key — the deterministic decision layer in
# `service-agent/agents/decision.js` runs the show and the Mastra agents are
# only used for richer conversational replies. If the key is missing or the
# call fails, the service keeps working.
OPENAI_API_KEY=your_openai_api_key_here

# Langfuse tracing (optional). When configured, every orchestrator call is
# traced with the chat session id.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Mem0 memory lookups (optional, track-3 will wire this in).
MEM0_API_KEY=

# --- Legacy AI providers (kept for fallback) ---
# --- MiniMax chat provider (legacy AI brain) ---
# Set USE_MASTRA_AGENT=false to route chat replies through the legacy
# minimax-agent.js (OpenAI-compatible API), which uses this key.
# Set ENABLE_LLM_REPLY_TEXT=true to let the agent generate natural-language
# replies (otherwise it falls back to deterministic templates).
MiniMax_API_KEY=your_minimax_chat_key_here
MiniMax_MODEL=MiniMax-M3
MiniMax_URL=https://api.MiniMax.io/v1/text/chatcompletion_v2
ENABLE_LLM_REPLY_TEXT=true

# --- MiniMax image/media generation ---
# Server-side only. Never expose this in frontend JavaScript.
MINIMAX_API_KEY=your_minimax_media_key_here
MINIMAX_API_BASE=https://api.minimax.io
MINIMAX_IMAGE_MODEL=image-01

# Gemini (used by `gemini-chatbot.js`).
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- WhatsApp (Meta / Twilio) ---
WHATSAPP_PROVIDER=meta
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=a_secure_random_string_of_your_choice
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id_here
WHATSAPP_APP_SECRET=
ADMIN_WHATSAPP_PHONE=+201000000000

# Deprecated legacy aliases. Do not use for new setup. Use WHATSAPP_*.
# WHATSAPP_TOKEN=your_meta_whatsapp_access_token_here
# META_VERIFY_TOKEN=a_secure_random_string_of_your_choice
# META_APP_SECRET=
# META_ACCESS_TOKEN=your_meta_whatsapp_access_token_here
# META_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
# META_WABA_ID=your_waba_id_here

# Alternative outbound provider when WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Meta social channels (Facebook Page + Instagram Business) ---
# Required before the social/comment agents can read or reply to real comments/messages.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=a_secure_random_string_for_meta_webhooks
META_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# --- TikTok / future social publishing ---
# Prepared for future publishing integration; manual export works without these.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=
POSTIZ_API_KEY=
POSTIZ_BASE_URL=

# --- InstaPay ---
# Direct auto-charge is not enabled without a merchant/payment-gateway contract.
# Add a real payment link or hosted QR image when available; otherwise the system
# uses the receiving mobile number and asks for receipt proof.
INSTAPAY_RECEIVING_NUMBER=01555567205
INSTAPAY_PAYMENT_LINK=
INSTAPAY_QR_IMAGE_URL=

# --- Future audio media ---
AUDIO_STORAGE_DIR=./data/audio
AUDIO_MAX_MB=25
AUDIO_ALLOWED_MIME=audio/webm,audio/mpeg,audio/mp4,audio/wav,audio/ogg
AUDIO_RETENTION_DAYS=90
AUDIO_PROCESSING_ENABLED=false

# --- Email ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# --- Admin ---
ADMIN_EMAIL=admin@carshineredsea.com
ADMIN_INITIAL_PASSWORD=ChangeMe123!
# Pre-hashed bcrypt password; set this for production so the auto-seed is skipped.
ADMIN_PASSWORD_HASH=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WHATSAPP_MAX=30
PUBLIC_FORM_RATE_LIMIT_WINDOW_MS=900000
PUBLIC_FORM_RATE_LIMIT_MAX=12
